# =========================
# PostgreSQL (app.py)
# =========================
DB_HOST=<instance_name>.postgres.database.azure.com
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# =========================
# Azure OpenAI (policy_selector.py)
# =========================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource_name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# =========================
# Azure AI Search (policy_selector.py)
# =========================
AZURE_SEARCH_ENDPOINT=https://<resource_name>.search.windows.net
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=

GITHUB_TOKEN= 

# =========================
# Azure OpenAI - Stage3 (PolicyComplianceEvaluator.py)
# =========================
AZURE_OPENAI_API_KEY_STAGE3=
AZURE_OPENAI_ENDPOINT_STAGE3=https://<resource_name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_STAGE3=
