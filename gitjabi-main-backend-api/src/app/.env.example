# 고유 비밀키를 SECRET_KEY에 입력하세요. (e.g. 4a632c247ae813a02c01d... )
SECRET_KEY=

API_GATEWAY_TYPE=azure
API_GATEWAY_HOST=
API_GATEWAY_SUBSCRIPTION_KEY=
# API_GATEWAY_SUBSCRIPTION_KEY는 API에 접근하기 위한 고유 키입니다. 
#   (ㅡAPI GATEWAY에서 해당 기능이 없거나 사용하지 않는 경우 빈 값 지정)

# Github Check-Run 등 기능 사용 위해 Github App의 정보를 입력
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/your_private_path/github-app-secret.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret
# WEBHOOK SECRET 값은 Github App에서 Webhook 섹션 내에서 지정한 사용자 지정 시크릿 값입니다.  
GITHUB_API_BASE_URL=https://api.github.com
# #########################################################
# ## API GATEWAY를 이용한다면                              ## 
# ## GITHUB API BASE URL은 게이트웨이 주소로 지정해야 합니다. ##
# #########################################################

AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://......-aoai.openai.azure.com

AZURE_SEARCH_ENDPOINT=https://.......search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=gitjabi-knowledge-index

CONTENT_SAFETY_KEY=
CONTENT_SAFETY_ENDPOINT=https://......-cs.cognitiveservices.azure.com/

LANGUAGE_KEY=
LANGUAGE_ENDPOINT=https://......-ls.cognitiveservices.azure.com/
